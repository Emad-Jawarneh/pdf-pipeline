<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net">
  <diagram id="document-processing-workflow" name="Document processing workflow">
    <mxGraphModel grid="1" gridSize="14" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="720" pageHeight="986" background="#141414" gridColor="#333333" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="heading-title-38" value="Event-driven document processing" style="text;html=1;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontColor=#FFFFFF;fontFamily=Arial;fontSize=25;" vertex="1" parent="1">
          <mxGeometry x="24" y="15" width="450" height="30" as="geometry" />
        </mxCell>
        <mxCell id="heading-phase-69" value="UPLOAD" style="text;html=1;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontColor=#FFFFFF;fontFamily=Arial;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="24" y="56" width="250" height="18" as="geometry" />
        </mxCell>
        <mxCell id="heading-phase-330" value="ASYNC PROCESSING" style="text;html=1;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontColor=#FFFFFF;fontFamily=Arial;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="447" y="317" width="250" height="18" as="geometry" />
        </mxCell>
        <mxCell id="heading-phase-644" value="OUTCOMES" style="text;html=1;align=left;verticalAlign=middle;spacing=0;strokeColor=none;fillColor=none;fontColor=#FFFFFF;fontFamily=Arial;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="24" y="631" width="250" height="18" as="geometry" />
        </mxCell>
        <mxCell id="upload" value="&lt;span style=&quot;font-size:16px&quot;&gt;Client → API · POST /api/documents&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Validate PDF contents, size, and page count&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=26;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#141414;strokeColor=#F5F5F5;strokeWidth=1.5;fontColor=#FFFFFF;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="24" y="85" width="410" height="58" as="geometry" />
        </mxCell>
        <mxCell id="invalid" value="&lt;span style=&quot;font-size:16px&quot;&gt;Invalid upload&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;API rejects the request&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=26;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#141414;strokeColor=#F5F5F5;strokeWidth=1.5;fontColor=#FFFFFF;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="478" y="85" width="220" height="58" as="geometry" />
        </mxCell>
        <mxCell id="record" value="&lt;span style=&quot;font-size:16px&quot;&gt;DynamoDB · Create document record&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Assign document ID and set UPLOADED&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=26;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#141414;strokeColor=#F5F5F5;strokeWidth=1.5;fontColor=#FFFFFF;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="24" y="169" width="410" height="58" as="geometry" />
        </mxCell>
        <mxCell id="original" value="&lt;span style=&quot;font-size:16px&quot;&gt;S3 input bucket · Store original PDF&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Object creation starts the workflow&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=26;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#141414;strokeColor=#F5F5F5;strokeWidth=1.5;fontColor=#FFFFFF;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="24" y="253" width="410" height="58" as="geometry" />
        </mxCell>
        <mxCell id="accepted" value="&lt;span style=&quot;font-size:16px&quot;&gt;API → Client&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;202 Accepted after both writes&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=26;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#141414;strokeColor=#F5F5F5;strokeWidth=1.5;fontColor=#FFFFFF;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="478" y="253" width="220" height="58" as="geometry" />
        </mxCell>
        <mxCell id="eventbridge" value="&lt;span style=&quot;font-size:16px&quot;&gt;EventBridge · Match Object Created event&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Route input bucket events to SQS&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=26;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#141414;strokeColor=#F5F5F5;strokeWidth=1.5;fontColor=#FFFFFF;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="24" y="348" width="410" height="58" as="geometry" />
        </mxCell>
        <mxCell id="queue" value="&lt;span style=&quot;font-size:16px&quot;&gt;SQS · Buffer processing jobs&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Event source mapping invokes Lambda&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=26;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#141414;strokeColor=#F5F5F5;strokeWidth=1.5;fontColor=#FFFFFF;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="24" y="432" width="410" height="58" as="geometry" />
        </mxCell>
        <mxCell id="worker" value="&lt;span style=&quot;font-size:16px&quot;&gt;Lambda · Claim processing version&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Conditionally set PROCESSING in DynamoDB&lt;br&gt;Read PDF from S3 and extract text, metadata, and counts&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=26;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#141414;strokeColor=#F5F5F5;strokeWidth=1.5;fontColor=#FFFFFF;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="24" y="516" width="410" height="88" as="geometry" />
        </mxCell>
        <mxCell id="stale" value="&lt;span style=&quot;font-size:16px&quot;&gt;Stale or completed job&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Acknowledge and skip&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=26;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#141414;strokeColor=#F5F5F5;strokeWidth=1.5;fontColor=#FFFFFF;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="478" y="516" width="220" height="69" as="geometry" />
        </mxCell>
        <mxCell id="success" value="&lt;span style=&quot;font-size:16px&quot;&gt;Success&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Write result to S3 output&lt;br&gt;Set COMPLETED in DynamoDB&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=26;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#141414;strokeColor=#F5F5F5;strokeWidth=1.5;fontColor=#FFFFFF;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="24" y="673" width="212" height="72" as="geometry" />
        </mxCell>
        <mxCell id="results" value="&lt;span style=&quot;font-size:16px&quot;&gt;Client → API&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Poll status and retrieve results&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=26;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#141414;strokeColor=#F5F5F5;strokeWidth=1.5;fontColor=#FFFFFF;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="24" y="768" width="212" height="58" as="geometry" />
        </mxCell>
        <mxCell id="permanent" value="&lt;span style=&quot;font-size:16px&quot;&gt;Permanent error&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Record failure reason&lt;br&gt;and acknowledge the message&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=26;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#141414;strokeColor=#F5F5F5;strokeWidth=1.5;fontColor=#FFFFFF;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="248" y="673" width="212" height="72" as="geometry" />
        </mxCell>
        <mxCell id="transient" value="&lt;span style=&quot;font-size:16px&quot;&gt;Transient error&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Set RETRYING for SQS redelivery&lt;br&gt;after the visibility timeout&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=26;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#141414;strokeColor=#F5F5F5;strokeWidth=1.5;fontColor=#FFFFFF;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="470" y="673" width="228" height="72" as="geometry" />
        </mxCell>
        <mxCell id="dead-letter" value="&lt;span style=&quot;font-size:16px&quot;&gt;SQS dead-letter queue&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Reconcile exhausted attempts&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=26;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#141414;strokeColor=#F5F5F5;strokeWidth=1.5;fontColor=#FFFFFF;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="470" y="768" width="228" height="58" as="geometry" />
        </mxCell>
        <mxCell id="failed" value="&lt;span style=&quot;font-size:16px&quot;&gt;FAILED&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Recorded in DynamoDB&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=26;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#141414;strokeColor=#F5F5F5;strokeWidth=1.5;fontColor=#FFFFFF;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="518" y="839" width="180" height="56" as="geometry" />
        </mxCell>
